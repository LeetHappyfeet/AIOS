# AIOS native application endpoints.
# Copy this file to .env only when you want to override the built-in defaults.
AIOS_DB_DSN=postgresql://postgres:postgres@127.0.0.1:5432/postgres
AIOS_FUSEKI_BASE_URL=http://127.0.0.1:3030
AIOS_QDRANT_URL=http://127.0.0.1:6333

# Docker Compose PostgreSQL settings. Keep these aligned with AIOS_DB_DSN.
AIOS_POSTGRES_DB=postgres
AIOS_POSTGRES_USER=postgres
AIOS_POSTGRES_PASSWORD=postgres
AIOS_POSTGRES_PORT=5432

# Docker Compose service ports.
AIOS_FUSEKI_PORT=3030
AIOS_QDRANT_HTTP_PORT=6333
AIOS_QDRANT_GRPC_PORT=6334

# Infrastructure versions/resources.
AIOS_JENA_VERSION=6.2.0
AIOS_FUSEKI_JAVA_OPTIONS=-Xms512m -Xmx2g
