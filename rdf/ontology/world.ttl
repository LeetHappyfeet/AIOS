@prefix world: <urn:aios:world#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Ontology
#################################################################

world:WorldOntology a owl:Ontology ;
  rdfs:label "AIOS World Observation Ontology" ;
  rdfs:comment "Defines observational claims and epistemic states. Claims represent observations, not assertions of truth." .

#################################################################
# Epistemic States
#################################################################

world:EpistemicState a owl:Class ;
  rdfs:label "Epistemic State" ;
  rdfs:comment "Represents how a claim is epistemically treated. Epistemic states are not worlds." .

# Liminal is a holding state for unverified observations.
# Claims in this state are NOT members of any asserted world.
world:Liminal a world:EpistemicState , owl:NamedIndividual ;
  rdfs:label "Liminal" ;
  rdfs:comment "Provisional epistemic state for observational claims. Not world membership; not truth." .

#################################################################
# Core Class: Claim
#################################################################

world:Claim a owl:Class ;
  rdfs:label "Observed Claim" ;
  rdfs:comment "A structured observation extracted from text or events; not an assertion of truth." .

#################################################################
# Claim Identity
#################################################################

world:claimId a owl:DatatypeProperty ;
  rdfs:domain world:Claim ;
  rdfs:range xsd:string ;
  rdfs:comment "Stable identifier for the claim (UUID from SQL claim_candidate)." .

#################################################################
# Epistemic State Assignment (NOT world membership)
#################################################################

world:epistemicState a owl:ObjectProperty ;
  rdfs:domain world:Claim ;
  rdfs:range world:EpistemicState ;
  rdfs:comment "Epistemic treatment of this claim (e.g., Liminal). Does not imply truth or world membership." .

#################################################################
# Claim Status (Mirrors SQL Lifecycle)
#################################################################

world:claimStatus a owl:DatatypeProperty ;
  rdfs:domain world:Claim ;
  rdfs:range xsd:string ;
  rdfs:comment "Processing status (pending, promoted, rejected, superseded)." .

#################################################################
# Surface Form (Lexical, Non-Ontological)
#################################################################

world:surfaceSubject a owl:DatatypeProperty ;
  rdfs:domain world:Claim ;
  rdfs:range xsd:string ;
  rdfs:comment "Lexical subject extracted from source text." .

world:surfacePredicate a owl:DatatypeProperty ;
  rdfs:domain world:Claim ;
  rdfs:range xsd:string ;
  rdfs:comment "Lexical predicate extracted from source text." .

world:surfaceObject a owl:DatatypeProperty ;
  rdfs:domain world:Claim ;
  rdfs:range xsd:string ;
  rdfs:comment "Lexical object extracted from source text." .

world:rawText a owl:DatatypeProperty ;
  rdfs:domain world:Claim ;
  rdfs:range xsd:string ;
  rdfs:comment "Authoritative raw sentence or utterance text." .

#################################################################
# Extraction Metadata
#################################################################

world:extractionRule a owl:DatatypeProperty ;
  rdfs:domain world:Claim ;
  rdfs:range xsd:string ;
  rdfs:comment "Rule or method used to extract the claim." .

world:extractionVersion a owl:DatatypeProperty ;
  rdfs:domain world:Claim ;
  rdfs:range xsd:string ;
  rdfs:comment "Version of extraction logic." .

# IMPORTANT: this is extraction confidence only (not belief strength / truth confidence).
world:extractionConfidence a owl:DatatypeProperty ;
  rdfs:domain world:Claim ;
  rdfs:range xsd:float ;
  rdfs:comment "Extractor confidence score (not truth confidence)." .

#################################################################
# Temporal Anchoring
#################################################################

world:observedAt a owl:DatatypeProperty ;
  rdfs:domain world:Claim ;
  rdfs:range xsd:dateTime ;
  rdfs:comment "Timestamp when the claim was observed or recorded." .

#################################################################
# Provenance (DAG / Source Traceability)
#################################################################

prov:wasDerivedFrom a owl:ObjectProperty ;
  rdfs:domain world:Claim ;
  rdfs:range prov:Entity ;
  rdfs:comment "Link to DAG node, sentence, or event from which the claim was derived." .

world:SourceDocument a owl:Class ;
  rdfs:label "Source Document" ;
  rdfs:comment "External document from which observations were extracted." .

world:sourceDocument a owl:ObjectProperty ;
  rdfs:domain world:Claim ;
  rdfs:range world:SourceDocument ;
  rdfs:comment "Source document associated with the claim." .

#################################################################
# Optional Semantic Resolution (Future Promotion Layer)
#################################################################

world:resolvedSubject a owl:ObjectProperty ;
  rdfs:domain world:Claim ;
  rdfs:comment "Resolved entity corresponding to the lexical subject (if any)." .

world:resolvedPredicate a owl:ObjectProperty ;
  rdfs:domain world:Claim ;
  rdfs:comment "Resolved predicate corresponding to the lexical predicate (if any)." .

world:resolvedObject a owl:ObjectProperty ;
  rdfs:domain world:Claim ;
  rdfs:comment "Resolved entity corresponding to the lexical object (if any)." .

#################################################################
# Asserted Worlds (defined elsewhere; referenced here for linkage)
#################################################################

world:World a owl:Class ;
  rdfs:label "World" ;
  rdfs:comment "An internally consistent world composed of promoted claims." .

world:memberOfWorld a owl:ObjectProperty ;
  rdfs:domain world:Claim ;
  rdfs:range world:World ;
  rdfs:comment "Indicates that a claim has been promoted into an asserted world (explicit promotion only)." .

#################################################################
# World Transitions (Explicit Elasticity)
#################################################################

world:WorldTransition a owl:Class ;
  rdfs:label "World Transition" ;
  rdfs:comment "Explicit transition between worlds due to contradiction, revision, or divergence." .

world:fromWorld a owl:ObjectProperty ;
  rdfs:domain world:WorldTransition ;
  rdfs:range world:World .

world:toWorld a owl:ObjectProperty ;
  rdfs:domain world:WorldTransition ;
  rdfs:range world:World .

world:triggeredByClaim a owl:ObjectProperty ;
  rdfs:domain world:WorldTransition ;
  rdfs:range world:Claim .

world:transitionTime a owl:DatatypeProperty ;
  rdfs:domain world:WorldTransition ;
  rdfs:range xsd:dateTime .

world:transitionReason a owl:DatatypeProperty ;
  rdfs:domain world:WorldTransition ;
  rdfs:range xsd:string ;
  rdfs:comment "Reason for world transition (contradiction, revision, fork, retraction)." .
