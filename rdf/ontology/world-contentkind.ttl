@prefix world: <urn:aios:world#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Liminal Content Classification Extension
#################################################################

# NOTE: contentKind is descriptive metadata about the discourse/structural role
# of an observed claim. It MUST NOT be used as belief strength, truth value,
# epistemic confidence, or world membership.
world:contentKind a owl:DatatypeProperty ;
    rdfs:domain world:Claim ;
    rdfs:range xsd:string ;
    rdfs:label "content kind" ;
    rdfs:comment
        "Structural classification of a liminal claim (e.g. content, navigation, footer, reference). This is not a truth judgment and must not be used to assert or deny truth." .

#################################################################
# Optional: controlled vocabulary (non-restrictive)
#################################################################

world:ContentKind a owl:Class ;
    rdfs:label "Content Kind" ;
    rdfs:comment
        "Describes the discourse or structural role of a claim's content. ContentKind does NOT express belief strength, truth value, epistemic confidence, or world membership. It must never be used to assert or deny truth." .

world:content a world:ContentKind ;
    rdfs:label "content" .

world:navigation a world:ContentKind ;
    rdfs:label "navigation" .

world:footer a world:ContentKind ;
    rdfs:label "footer" .

world:boilerplate a world:ContentKind ;
    rdfs:label "boilerplate" .

world:copyright a world:ContentKind ;
    rdfs:label "copyright" .

world:pronounHeavy a world:ContentKind ;
    rdfs:label "pronoun-heavy" .

world:unknown a world:ContentKind ;
    rdfs:label "unknown" .

world:reference a world:ContentKind ;
    rdfs:label "reference" ;
    rdfs:comment
        "Bibliographic, citation, or reference material (dates, ISBNs, publisher names, retrieval notes). Not propositional content." .
